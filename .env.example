# Dev (native Ollama on Windows host):
OLLAMA_HOST=http://host.docker.internal:11434
# Full profile (containerised Ollama):
# OLLAMA_HOST=http://ollama:11434

MODEL_EXTRACT=dolphin-llama3
MODEL_REWRITE=dolphin-llama3
NUM_CTX=8192
TEMP_EXTRACT=0.0
TEMP_REWRITE=0.15
TOP_P=0.9
